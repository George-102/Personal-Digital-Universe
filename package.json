{
  "name": "personal-digital-universe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "verify": "npm run verify:build && npm run verify:e2e && npm run verify:lighthouse && npm run verify:metrics",
    "verify:build": "next build",
    "verify:e2e": "playwright test",
    "verify:lighthouse": "lhci autorun",
    "verify:quick": "next build && playwright test --project=chromium-no-webgl",
    "verify:metrics": "npm run audit && npm run check:i18n && npm run size",
    "audit": "npm audit --audit-level=high --registry=https://registry.npmjs.org",
    "check:i18n": "node scripts/check-i18n.mjs",
    "size": "size-limit",
    "test": "node --test scripts/"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.50.0",
    "@size-limit/file": "^11.0.0",
    "serve": "^14.2.0",
    "size-limit": "^11.0.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.6",
    "compression": "^1.8.2"
  }
}