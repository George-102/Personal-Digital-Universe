{
  "name": "personal-digital-universe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/validate-content.mjs && node scripts/sync-licenses.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run verify:build && npm run verify:e2e && npm run verify:lighthouse && npm run verify:metrics",
    "verify:build": "next build",
    "verify:e2e": "playwright test",
    "verify:lighthouse": "lhci autorun",
    "verify:quick": "next build && playwright test --project=chromium-no-webgl",
    "verify:local": "npm run lint && npm run typecheck && npm run build && npm test && npm run verify:metrics",
    "verify:metrics": "npm run audit && npm run check:i18n && npm run size",
    "audit": "npm audit --audit-level=high --registry=https://registry.npmjs.org",
    "check:i18n": "node scripts/check-i18n.mjs",
    "size": "size-limit",
    "test": "node --test scripts/"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "gsap": "3.15.1",
    "next": "^15.5.0",
    "next-intl": "^4.14.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.50.0",
    "@size-limit/file": "^11.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "serve": "^14.2.0",
    "size-limit": "^11.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "wrangler": "4.160.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.6",
    "compression": "^1.8.2",
    "postcss": "^8.5.32"
  }
}
